{
  "name": "docshift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private, storage-free document workbench. Everything happens in your browser; nothing is stored.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "privacy:check": "node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "mupdf": "^1.28.0",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
